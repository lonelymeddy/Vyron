# ==========================================
# VYRON AI - ENVIRONMENT CONFIGURATION
# ==========================================

APP_NAME="VYRON AI"
APP_ENV=development
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://vyron-1uaj.onrender.com,https://vyron-frontend.onrender.com,https://vyron-ai.vercel.app

# Port Configuration
PORT=3000
BACKEND_PORT=8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Frontend public API endpoint (leave blank for same-origin unified deployment)
NEXT_PUBLIC_API_URL=

# Direct PostgreSQL connection string or SQLite local fallback
# Note: postgres:// connection strings are automatically transformed to postgresql://
DATABASE_URL=sqlite:///./vyron.db
# DATABASE_URL=postgresql://vyron_user:vyron_password@localhost:5432/vyron_db

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_ALGORITHM=HS256

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=vyron-assets
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=/static

DEFAULT_AI_PROVIDER=mock_engine
KLING_API_KEY=
KLING_API_BASE_URL=https://api.klingai.com/v1
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.runwayml.com/v1
