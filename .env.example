# ==========================================
# VYRON AI - ENVIRONMENT CONFIGURATION
# ==========================================

APP_NAME="VYRON AI"
APP_ENV=development
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Direct PostgreSQL connection string or SQLite local fallback
DATABASE_URL=postgresql://vyron_user:vyron_password@localhost:5432/vyron_db
# DATABASE_URL=sqlite:///./vyron.db

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_ALGORITHM=HS256

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

STORAGE_PROVIDER=r2
STORAGE_BUCKET_NAME=vyron-assets
STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_PUBLIC_URL=https://assets.vyron.ai

DEFAULT_AI_PROVIDER=mock_engine
KLING_API_KEY=
KLING_API_BASE_URL=https://api.klingai.com/v1
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.runwayml.com/v1
